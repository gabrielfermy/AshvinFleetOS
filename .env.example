# Environment Configuration Template for Ashvin FleetOS (AFOS)

# -----------------------------------------------------------------------------
# SUPABASE LOCAL DOCKER CONFIGURATION
# -----------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_afos_local
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_for_afos_local

# -----------------------------------------------------------------------------
# DATABASE DIRECT ACCESS (POSTGRESQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# APP CLIENT CONFIGURATION (FLUTTER)
# -----------------------------------------------------------------------------
AFOS_APP_ENV=development
AFOS_DEFAULT_LOCALE=id
AFOS_SUPPORTED_LOCALES=id,en,ja,ko,zh
AFOS_STORAGE_CDN_URL=http://localhost:54321/storage/v1/object/public

# -----------------------------------------------------------------------------
# NOTIFICATION & SERVICE THRESHOLDS
# -----------------------------------------------------------------------------
AFOS_MAINTENANCE_THRESHOLD_KM=5000
AFOS_OIL_CHANGE_THRESHOLD_KM=10000
AFOS_TAX_REMINDER_DAYS_BEFORE=30
